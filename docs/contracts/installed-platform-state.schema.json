{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nomotect.example/schemas/installed-platform-state-v2.json",
  "title": "Installed Platform State",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observed_at", "environment", "platform", "runtime", "contracts", "installation", "deployment", "database", "generated_artifacts", "extensions"],
  "properties": {
    "schema_version": { "const": 2 },
    "observed_at": { "type": "string", "format": "date-time" },
    "environment": { "type": "string", "minLength": 1 },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "version": {
          "type": ["string", "null"],
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruby", "rails", "postgresql"],
      "properties": {
        "ruby": { "$ref": "#/$defs/nullableVersion" },
        "rails": { "$ref": "#/$defs/nullableVersion" },
        "postgresql": { "$ref": "#/$defs/nullableVersion" }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 1 }
    },
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "state"],
      "properties": {
        "contract_version": { "type": ["integer", "null"], "minimum": 1 },
        "state": { "type": "string", "minLength": 1 },
        "error": { "type": "string" }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "profile"],
      "properties": {
        "contract_version": { "type": ["integer", "null"], "minimum": 1 },
        "profile": { "type": ["string", "null"] }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "schema_version", "pending_migrations"],
      "properties": {
        "available": { "type": "boolean" },
        "schema_version": { "type": ["string", "null"], "pattern": "^[0-9]+$" },
        "pending_migrations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["version", "name"],
            "properties": {
              "version": { "type": "string", "pattern": "^[0-9]+$" },
              "name": { "type": "string", "minLength": 1 }
            }
          }
        },
        "error": { "type": "string" }
      }
    },
    "generated_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current", "checks"],
      "properties": {
        "current": { "type": "boolean" },
        "checks": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "package", "version", "required", "contract_version", "status", "finding_codes", "capabilities", "components", "pending_migrations"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "package": { "$ref": "#/$defs/identifier" },
          "version": {
            "oneOf": [
              { "type": "null" },
              { "$ref": "#/$defs/semanticVersion" }
            ]
          },
          "required": { "type": "boolean" },
          "contract_version": { "type": ["integer", "null"], "minimum": 1 },
          "status": { "enum": ["ready", "blocked", "unavailable"] },
          "finding_codes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "version"],
              "properties": {
                "id": { "$ref": "#/$defs/identifier" },
                "version": { "type": "integer", "minimum": 1 }
              }
            }
          },
          "components": {
            "type": "object",
            "additionalProperties": false,
            "required": ["configuration", "migrations", "routes", "assets", "documentation"],
            "properties": {
              "configuration": { "type": "boolean" },
              "migrations": {
                "type": "object",
                "additionalProperties": false,
                "required": ["namespace", "paths"],
                "properties": {
                  "namespace": {
                    "oneOf": [
                      { "type": "null" },
                      { "$ref": "#/$defs/identifier" }
                    ]
                  },
                  "paths": { "type": "integer", "minimum": 0 }
                }
              },
              "routes": { "$ref": "#/$defs/nullableNamespace" },
              "assets": { "$ref": "#/$defs/nullableNamespace" },
              "documentation": { "type": "boolean" }
            }
          },
          "pending_migrations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["namespace", "version", "name"],
              "properties": {
                "namespace": { "$ref": "#/$defs/identifier" },
                "version": { "type": "string", "pattern": "^[0-9]+$" },
                "name": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*([.-][a-z0-9]+)*$"
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "nullableNamespace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace"],
      "properties": {
        "namespace": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/identifier" }
          ]
        }
      }
    },
    "nullableVersion": {
      "type": ["string", "null"],
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    }
  }
}
