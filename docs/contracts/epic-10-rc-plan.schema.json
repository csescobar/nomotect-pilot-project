{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nomotect.dev/contracts/epic-10-rc-plan.schema.json",
  "title": "NomoTect Epic 10 Release Candidate Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "source_version", "target_version", "tag", "source_commit", "inputs", "required_evidence", "approval", "publication"],
  "properties": {
    "schema_version": { "const": 1 },
    "status": { "const": "review_required" },
    "source_version": { "const": "0.9.0" },
    "target_version": { "type": "string", "pattern": "^1\\.0\\.0-rc\\.[1-9][0-9]*$" },
    "tag": { "type": "string", "pattern": "^v1\\.0\\.0-rc\\.[1-9][0-9]*$" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_baseline_digest", "changelog_digest", "fragment_ids", "fragment_digest"],
      "properties": {
        "release_baseline_digest": { "$ref": "#/$defs/digest" },
        "changelog_digest": { "$ref": "#/$defs/digest" },
        "fragment_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "fragment_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "required_evidence": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "required", "approved"],
      "properties": {
        "environment": { "const": "release-candidate" },
        "required": { "const": true },
        "approved": { "const": false }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "tag_created", "artifacts_published"],
      "properties": {
        "allowed": { "const": false },
        "tag_created": { "const": false },
        "artifacts_published": { "const": false }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
