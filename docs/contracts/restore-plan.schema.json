{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nomotect.example/contracts/restore-plan-v1.json",
  "title": "Credential-free operational restore plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "backup_manifest_id", "target", "ordered_steps", "verification"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "backup_manifest_id": { "type": "string", "minLength": 1 },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "platform_version"],
      "properties": {
        "environment": { "type": "string", "minLength": 1 },
        "platform_version": { "type": "string", "minLength": 1 }
      }
    },
    "ordered_steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "component", "action", "requires", "operator_confirmation"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "component": {
            "enum": ["postgresql", "persistent_files", "generated_configuration", "installation_metadata"]
          },
          "action": { "type": "string", "minLength": 1 },
          "requires": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "operator_confirmation": { "type": "boolean" }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["database_schema", "installation_contract", "generated_artifacts", "application_health"],
      "properties": {
        "database_schema": { "type": "boolean" },
        "installation_contract": { "type": "boolean" },
        "generated_artifacts": { "type": "boolean" },
        "application_health": { "type": "boolean" }
      }
    }
  }
}
