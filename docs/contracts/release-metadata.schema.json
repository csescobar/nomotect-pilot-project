{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nomotect.example/contracts/release-metadata.schema.json",
  "title": "Prepared release metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_version",
    "target_version",
    "release_impact",
    "fragment_ids",
    "fragment_digest",
    "compatibility_digest"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "source_version": { "type": "string" },
    "target_version": { "type": "string" },
    "release_impact": { "enum": ["none", "patch", "minor", "major"] },
    "fragment_ids": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "fragment_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "compatibility_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
