{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nomotect.example/contracts/release-evidence.schema.json",
  "title": "Release consistency evidence input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "version",
    "tag",
    "release_metadata",
    "release_notes",
    "compatibility",
    "application_sbom",
    "container_sbom",
    "packaging_manifest",
    "provenance"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "version": { "type": "string" },
    "tag": { "type": "string" },
    "release_metadata": { "$ref": "#/$defs/path" },
    "release_notes": { "$ref": "#/$defs/path" },
    "compatibility": { "$ref": "#/$defs/path" },
    "application_sbom": { "$ref": "#/$defs/path" },
    "container_sbom": { "$ref": "#/$defs/path" },
    "packaging_manifest": { "$ref": "#/$defs/path" },
    "provenance": { "$ref": "#/$defs/path" }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1
    }
  }
}
