{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nomotect.dev/contracts/epic-10-finding.schema.json",
  "title": "NomoTect Epic 10 Finding",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "phase", "severity", "status", "summary", "owner", "remediation", "evidence", "waiver"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "phase": { "$ref": "#/$defs/id" },
    "severity": { "enum": ["critical", "high", "medium", "low"] },
    "status": { "enum": ["open", "resolved", "accepted"] },
    "summary": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "remediation": { "type": "string", "minLength": 1 },
    "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "waiver": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["owner", "rationale", "approved_by", "approved_at", "expires_at"],
          "properties": {
            "owner": { "type": "string", "minLength": 1 },
            "rationale": { "type": "string", "minLength": 1 },
            "approved_by": { "type": "string", "minLength": 1 },
            "approved_at": { "type": "string", "format": "date-time" },
            "expires_at": { "type": "string", "format": "date-time" }
          }
        }
      ]
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
  }
}
