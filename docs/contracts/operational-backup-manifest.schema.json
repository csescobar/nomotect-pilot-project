{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nomotect.example/contracts/operational-backup-manifest-v1.json",
  "title": "Credential-free operational backup manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "captured_at", "source", "components"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "captured_at": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform_version", "source_commit", "database_schema", "installation_contract"],
      "properties": {
        "platform_version": { "type": "string", "minLength": 1 },
        "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "database_schema": { "type": "string", "pattern": "^[0-9]+$" },
        "installation_contract": { "type": "integer", "minimum": 1 }
      }
    },
    "components": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "provider", "reference", "checksum", "size_bytes"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": ["postgresql", "persistent_files", "generated_configuration", "installation_metadata"]
          },
          "provider": { "type": "string", "minLength": 1 },
          "reference": { "type": "string", "minLength": 1 },
          "checksum": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
