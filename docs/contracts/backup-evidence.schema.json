{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nomotect.example/schemas/backup-evidence-v1.json",
  "title": "Backup Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "kind", "captured_at", "source", "provider", "reference", "checksum"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["database", "persistent_files"] },
    "captured_at": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform_version", "database_schema", "installation_contract"],
      "properties": {
        "platform_version": { "type": "string", "minLength": 1 },
        "database_schema": { "type": "string", "pattern": "^[0-9]+$" },
        "installation_contract": { "type": "integer", "minimum": 1 }
      }
    },
    "provider": { "type": "string", "minLength": 1 },
    "reference": { "type": "string", "minLength": 1 },
    "checksum": { "type": ["string", "null"] }
  }
}
