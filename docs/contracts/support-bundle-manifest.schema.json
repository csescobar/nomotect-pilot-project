{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nomotect.example/contracts/support-bundle-manifest.schema.json",
  "title": "NomoTect support bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "generated_at",
    "source",
    "limits",
    "files",
    "redactions",
    "automated_upload"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^support-[0-9]{8}T[0-9]{6}Z$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform_version", "source_commit", "environment"],
      "properties": {
        "platform_version": { "type": "string", "minLength": 1 },
        "source_commit": { "type": "string", "minLength": 1 },
        "environment": { "type": "string", "minLength": 1 }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_entry_bytes", "max_bundle_bytes"],
      "properties": {
        "max_entry_bytes": { "type": "integer", "minimum": 1 },
        "max_bundle_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "media_type", "size_bytes", "checksum"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "path": { "type": "string", "pattern": "^reports/[a-z][a-z0-9_]*\\.json$" },
          "media_type": { "const": "application/json" },
          "size_bytes": { "type": "integer", "minimum": 1 },
          "checksum": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    },
    "redactions": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "automated_upload": { "const": false }
  }
}
