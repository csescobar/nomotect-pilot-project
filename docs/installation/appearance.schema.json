{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Installation appearance configuration",
  "type": "object",
  "required": ["schema_version", "environment", "application_name", "default_locale", "supported_locales"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "environment": { "type": "string", "minLength": 1 },
    "application_name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "default_locale": { "type": "string", "enum": ["en", "pt-BR"] },
    "supported_locales": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["en", "pt-BR"] }
    },
    "logo_path": { "type": ["string", "null"] },
    "compact_logo_path": { "type": ["string", "null"] },
    "favicon_path": { "type": ["string", "null"] },
    "design_tokens_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
