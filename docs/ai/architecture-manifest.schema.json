{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/csescobar/nomotect-platform/docs/ai/architecture-manifest.schema.json",
  "title": "Rails Hotwire Platform Architecture Manifest",
  "type": "object",
  "required": ["version", "modules"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "name", "context", "boundary", "dependencies"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "context": { "type": "string", "minLength": 1 },
          "boundary": {
            "type": "string",
            "enum": ["standard", "review_required", "architecture_review_required", "generated"]
          },
          "dependencies": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "publicApi": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "owners": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "adrs": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
