{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nomotect.example/schemas/database-provisioning.schema.json",
  "title": "Database Provisioning Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "host",
    "port",
    "maintenance_database",
    "application_database",
    "application_username",
    "sslmode"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "host": { "type": "string", "minLength": 1 },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "maintenance_database": { "type": "string", "minLength": 1 },
    "application_database": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" },
    "application_username": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" },
    "sslmode": {
      "enum": ["disable", "allow", "prefer", "require", "verify-ca", "verify-full"]
    }
  },
  "not": {
    "anyOf": [
      { "required": ["admin_password"] },
      { "required": ["password"] },
      { "required": ["database_url"] }
    ]
  }
}
