{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nomotect.local/contracts/platform-owner-completion.schema.json",
  "title": "Platform Administrator Completion Contract",
  "type": "object",
  "required": [
    "contract_version",
    "status",
    "platform_admin_user_id",
    "platform_role_id",
    "initial_organization_id",
    "initial_owner_membership_id"
  ],
  "properties": {
    "contract_version": { "const": 1 },
    "status": { "const": "completed" },
    "platform_admin_user_id": { "type": ["integer", "string"] },
    "platform_role_id": { "type": ["integer", "string"] },
    "initial_organization_id": { "type": ["integer", "string"] },
    "initial_owner_membership_id": { "type": ["integer", "string"] }
  },
  "additionalProperties": false
}
