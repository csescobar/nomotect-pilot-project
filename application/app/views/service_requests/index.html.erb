<% content_for :title, t("service_requests.index.title", organization: @organization.name) %>

<%= render Ui::Layout::PageHeaderComponent.new(title: t("service_requests.index.title", organization: @organization.name), description: t("service_requests.index.description")) do %>
  <% if allowed_to?(ServiceRequest.new(organization: @organization), :create?) %>
    <%= link_to t("service_requests.actions.new"), new_organization_service_request_path(@organization), class: "button button--primary" %>
  <% end %>
<% end %>

<%= render "grid", organization: @organization %>

<div class="page-stack">
  <%= link_to t("service_requests.actions.export_csv"), grid_path("service_requests", format: :csv), class: "button button--ghost button--small" %>
</div>
