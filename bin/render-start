#!/usr/bin/env bash
set -euo pipefail

persistence_root="${RENDER_PERSISTENCE_ROOT:-/rails/storage}"
installation_target="${persistence_root}/installation"
branding_target="${persistence_root}/branding"

mkdir -p "$persistence_root" "$installation_target" "$branding_target" /rails/var /rails/public/installation

rm -rf /rails/var/installation /rails/public/installation/branding
ln -s "$installation_target" /rails/var/installation
ln -s "$branding_target" /rails/public/installation/branding

if [[ $# -gt 0 ]]; then
  exec "$@"
fi

exec bundle exec puma -C config/puma.rb
