#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require_relative "../config/environment"

begin
  commit = ARGV.fetch(0) { abort "Usage: bin/epic-10-accessibility-certify SOURCE_COMMIT" }
  puts JSON.pretty_generate(Epic10::AccessibilityCertification.new(source_commit: commit).call)
rescue Epic10::AccessibilityCertification::InvalidCertification => error
  warn error.message
  exit 1
end
