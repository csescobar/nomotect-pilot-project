#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../config/environment"

begin
  commit = ARGV.fetch(0) { abort "Usage: bin/epic-10-ai-readiness-certify SOURCE_COMMIT" }
  report = Epic10::AiReadinessCertification.new(source_commit: commit).call
  puts JSON.pretty_generate(report)
rescue Epic10::AiReadinessCertification::InvalidCertification => error
  warn error.message
  exit 2
end
