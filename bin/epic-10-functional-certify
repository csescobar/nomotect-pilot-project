#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require_relative "../config/environment"

begin
  commit = ARGV.fetch(0) { abort "Usage: bin/epic-10-functional-certify SOURCE_COMMIT" }
  report = Epic10::FunctionalFrameworkCertification.new(source_commit: commit).call
  puts JSON.pretty_generate(report)
rescue Epic10::FunctionalFrameworkCertification::InvalidCertification => error
  warn error.message
  exit 1
end
