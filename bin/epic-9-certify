#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require_relative "../lib/epic_9/certification"

root = File.expand_path("..", __dir__)
result = Epic9::Certification.new(
  repository_path: root,
  catalog_path: File.join(root, "config/epic_9/certification.yml")
).certify

puts JSON.pretty_generate(result)
exit(result.fetch(:status) == "certified" ? 0 : 1)
