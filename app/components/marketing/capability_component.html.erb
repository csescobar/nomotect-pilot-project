        </div>
        <h3 class="mkt-card__title"><%= t("marketing.capabilities.foundation_title") %></h3>
        <p class="mkt-card__body"><%= t("marketing.capabilities.foundation_desc") %></p>
      </div>

      <div class="mkt-card">
        <div class="mkt-card__icon mkt-card__icon--secondary">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-23"/></svg>
