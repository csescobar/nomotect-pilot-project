<section class="mkt-section mkt-section--dark" id="lifecycle">
  <div class="mkt-container">
    <div class="mkt-section-header mkt-section-header--dark">
      <h2 class="mkt-section-title"><%= t("marketing.lifecycle.heading") %></h2>
    </div>

    <div class="mkt-lifecycle-timeline">
      <div class="mkt-lifecycle-item">
        <div class="mkt-lifecycle-item__badge"><%= t("marketing.lifecycle.status_core") %></div>
        <h3 class="mkt-lifecycle-item__title">01. <%= t("marketing.lifecycle.stage_1") %></h3>
      </div>
      <div class="mkt-lifecycle-item">
        <div class="mkt-lifecycle-item__badge"><%= t("marketing.lifecycle.status_core") %></div>
        <h3 class="mkt-lifecycle-item__title">02. <%= t("marketing.lifecycle.stage_2") %></h3>
      </div>
      <div class="mkt-lifecycle-item">
        <div class="mkt-lifecycle-item__badge"><%= t("marketing.lifecycle.status_active") %></div>
        <h3 class="mkt-lifecycle-item__title">03. <%= t("marketing.lifecycle.stage_3") %></h3>
      </div>
      <div class="mkt-lifecycle-item">
        <div class="mkt-lifecycle-item__badge"><%= t("marketing.lifecycle.status_active") %></div>
        <h3 class="mkt-lifecycle-item__title">04. <%= t("marketing.lifecycle.stage_4") %></h3>
      </div>
      <div class="mkt-lifecycle-item">
        <div class="mkt-lifecycle-item__badge"><%= t("marketing.lifecycle.status_stable") %></div>
        <h3 class="mkt-lifecycle-item__title">05. <%= t("marketing.lifecycle.stage_5") %></h3>
      </div>
      <div class="mkt-lifecycle-item">
        <div class="mkt-lifecycle-item__badge"><%= t("marketing.lifecycle.status_stable") %></div>
        <h3 class="mkt-lifecycle-item__title">06. <%= t("marketing.lifecycle.stage_6") %></h3>
      </div>
      <div class="mkt-lifecycle-item">
        <div class="mkt-lifecycle-item__badge"><%= t("marketing.lifecycle.status_active") %></div>
        <h3 class="mkt-lifecycle-item__title">07. <%= t("marketing.lifecycle.stage_7") %></h3>
      </div>
    </div>
  </div>
</section>
