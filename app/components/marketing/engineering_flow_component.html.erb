<section class="mkt-section mkt-section--subtle" id="ai-native">
  <div class="mkt-container">
    <div class="mkt-section-header">
      <div class="mkt-badge mkt-badge--teal">
        <span>AI-Native Governance</span>
      </div>
      <h2 class="mkt-section-title"><%= t("marketing.ai_section.heading") %></h2>
      <p class="mkt-section-description"><%= t("marketing.ai_section.description") %></p>
    </div>

    <div class="mkt-flow">
      <div class="mkt-flow__step">
        <div class="mkt-flow__body">
          <div class="mkt-flow__num">01</div>
          <h3 class="mkt-flow__title"><%= t("marketing.ai_section.step_1_title") %></h3>
          <p class="mkt-flow__desc"><%= t("marketing.ai_section.step_1_desc") %></p>
        </div>
        <div class="mkt-flow__footer">
          <code class="mkt-flow__code">config/ai/contracts/*.yml</code>
        </div>
      </div>

      <div class="mkt-flow__arrow">→</div>

      <div class="mkt-flow__step">
        <div class="mkt-flow__body">
          <div class="mkt-flow__num">02</div>
          <h3 class="mkt-flow__title"><%= t("marketing.ai_section.step_2_title") %></h3>
          <p class="mkt-flow__desc"><%= t("marketing.ai_section.step_2_desc") %></p>
        </div>
        <div class="mkt-flow__footer">
          <code class="mkt-flow__code">AI_CONTEXT.md</code>
        </div>
      </div>

      <div class="mkt-flow__arrow">→</div>

      <div class="mkt-flow__step">
        <div class="mkt-flow__body">
          <div class="mkt-flow__num">03</div>
          <h3 class="mkt-flow__title"><%= t("marketing.ai_section.step_3_title") %></h3>
          <p class="mkt-flow__desc"><%= t("marketing.ai_section.step_3_desc") %></p>
        </div>
        <div class="mkt-flow__footer">
          <code class="mkt-flow__code">config/ai/playbooks/*.yml</code>
        </div>
      </div>

      <div class="mkt-flow__arrow">→</div>

      <div class="mkt-flow__step">
        <div class="mkt-flow__body">
          <div class="mkt-flow__num">04</div>
          <h3 class="mkt-flow__title"><%= t("marketing.ai_section.step_4_title") %></h3>
          <p class="mkt-flow__desc"><%= t("marketing.ai_section.step_4_desc") %></p>
        </div>
        <div class="mkt-flow__footer">
          <code class="mkt-flow__code">bin/repository-intelligence</code>
        </div>
      </div>

      <div class="mkt-flow__arrow">→</div>

      <div class="mkt-flow__step mkt-flow__step--final">
        <div class="mkt-flow__body">
          <div class="mkt-flow__num">05</div>
          <h3 class="mkt-flow__title"><%= t("marketing.ai_section.step_5_title") %></h3>
          <p class="mkt-flow__desc"><%= t("marketing.ai_section.step_5_desc") %></p>
        </div>
        <div class="mkt-flow__footer">
          <code class="mkt-flow__code">Pull Request Approval</code>
        </div>
      </div>
    </div>
  </div>
</section>
