<section class="mkt-hero" id="hero">
  <div class="mkt-container mkt-hero__inner">
    <div class="mkt-hero__content">
      <div class="mkt-badge mkt-hero__eyebrow">
        <%= image_tag "brand/Service Desk Lite_Arc02_Micro.svg", alt: "", class: "mkt-badge__icon", height: 20, width: 20 %>
        <span><%= t("marketing.hero.eyebrow") %></span>
      </div>

      <h1 class="mkt-hero__headline">
        <span class="mkt-hero__headline-primary"><%= t("marketing.hero.headline_1") %></span>
        <span class="mkt-hero__headline-accent"><%= t("marketing.hero.headline_2") %></span>
      </h1>

      <p class="mkt-hero__description">
        <%= t("marketing.hero.description") %>
      </p>

      <div class="mkt-hero__actions">
        <a href="#capabilities" class="button button--primary button--large">
          <%= t("marketing.hero.primary_cta") %>
        </a>
        <a href="https://github.com/csescobar/nomotect-platform" class="button button--secondary button--large" target="_blank" rel="noopener">
          <%= t("marketing.hero.secondary_cta") %>
        </a>
      </div>

      <ul class="mkt-hero__principles">
        <li class="mkt-hero__principle">
          <svg class="mkt-hero__check" viewBox="0 0 20 20" width="16" height="16" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
          <span><%= t("marketing.hero.principle_1") %></span>
        </li>
        <li class="mkt-hero__principle">
          <svg class="mkt-hero__check" viewBox="0 0 20 20" width="16" height="16" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
          <span><%= t("marketing.hero.principle_2") %></span>
        </li>
        <li class="mkt-hero__principle">
          <svg class="mkt-hero__check" viewBox="0 0 20 20" width="16" height="16" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
          <span><%= t("marketing.hero.principle_3") %></span>
        </li>
      </ul>
    </div>
  </div>
</section>
