<section class="mkt-section" id="open-source">
  <div class="mkt-container">
    <div class="mkt-section-header">
      <h2 class="mkt-section-title"><%= t("marketing.open_source.heading") %></h2>
    </div>

    <div class="mkt-grid mkt-grid--2cols">
      <div class="mkt-card mkt-card--bordered">
        <h3 class="mkt-card__title"><%= t("marketing.open_source.license_title") %></h3>
        <p class="mkt-card__body"><%= t("marketing.open_source.license_desc") %></p>
      </div>
      <div class="mkt-card mkt-card--bordered">
        <h3 class="mkt-card__title"><%= t("marketing.open_source.neutral_title") %></h3>
        <p class="mkt-card__body"><%= t("marketing.open_source.neutral_desc") %></p>
      </div>
    </div>

    <div class="mkt-stack-box">
      <h3 class="mkt-stack-box__title"><%= t("marketing.open_source.stack_heading") %></h3>
      <div class="mkt-stack-pills">
        <span class="mkt-pill">Ruby 3.4</span>
        <span class="mkt-pill">Rails 8</span>
        <span class="mkt-pill">Hotwire</span>
        <span class="mkt-pill">ViewComponent</span>
        <span class="mkt-pill">PostgreSQL</span>
        <span class="mkt-pill">Minitest</span>
      </div>
    </div>
  </div>
</section>
